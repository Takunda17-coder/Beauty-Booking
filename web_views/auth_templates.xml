<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Professional Login Template -->
        <template id="portal_login" name="Professional Portal Login">
            <html>
                <head>
                    <meta charset="utf-8"/>
                    <meta name="viewport" content="width=device-width, initial-scale=1"/>
                    <title>Professional Portal - Login</title>
                    <link rel="stylesheet" href="/web/static/lib/bootstrap/dist/css/bootstrap.css"/>
                    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"/>
                    <link rel="stylesheet" href="/web/static/src/libs/fontawesome/css/font-awesome.css"/>
                    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer"/>
                    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap"/>
                    <style>
                        :root, [data-theme="light"] {
                            --bg-main: #f8fafc;
                            --bg-card: #ffffff;
                            --border-color: #e2e8f0;
                            --text-main: #0f172a;
                            --text-muted: #64748b;
                            --accent: #6366f1;
                            --input-bg: #f8fafc;
                        }
                        [data-theme="dark"] {
                            --bg-main: #0b0f19;
                            --bg-card: #111827;
                            --border-color: #1f2937;
                            --text-main: #f9fafb;
                            --text-muted: #9ca3af;
                            --accent: #818cf8;
                            --input-bg: #1f2937;
                        }
                        body {
                            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
                            background-color: var(--bg-main);
                            color: var(--text-main);
                            min-height: 100vh;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            margin: 0;
                            position: relative;
                        }
                        .auth-wrap {
                            padding: 40px 15px;
                            width: 100%;
                            max-width: 440px;
                        }
                        .auth-card {
                            background-color: var(--bg-card);
                            border: 1px solid var(--border-color);
                            border-radius: 24px;
                            box-shadow: 0 4px 25px rgba(0,0,0,0.04);
                            padding: 2.5rem;
                        }
                        .theme-top-right {
                            position: absolute;
                            top: 20px;
                            right: 20px;
                        }
                        .theme-toggle-btn {
                            background: transparent;
                            border: 1px solid var(--border-color);
                            color: var(--text-main);
                            width: 40px;
                            height: 40px;
                            border-radius: 50%;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            cursor: pointer;
                        }
                        .form-control {
                            background-color: var(--input-bg);
                            border: 1px solid var(--border-color);
                            color: var(--text-main);
                            border-radius: 12px;
                            padding: 11px 14px;
                        }
                        .form-control:focus {
                            border-color: var(--accent);
                            background-color: var(--bg-card);
                            color: var(--text-main);
                        }
                        .btn-auth {
                            background-color: var(--accent);
                            color: #ffffff;
                            border: none;
                            border-radius: 999px;
                            padding: 0.85rem;
                            font-weight: 700;
                            width: 100%;
                            min-height: 48px;
                            display: inline-flex;
                            align-items: center;
                            justify-content: center;
                        }
                        @media (max-width: 575.98px) {
                            .auth-wrap {
                                padding: 24px 12px;
                            }
                            .auth-card {
                                padding: 1.5rem 1.25rem !important;
                                border-radius: 20px !important;
                            }
                            .form-control {
                                font-size: 16px !important;
                            }
                            .theme-top-right {
                                top: 12px;
                                right: 12px;
                            }
                        }
                    </style>
                </head>
                <body>
                    <div class="theme-top-right">
                        <button class="theme-toggle-btn" onclick="toggleTheme()" title="Toggle Dark/Light Mode">
                            <i id="themeToggleIcon" class="fa fa-moon-o"/>
                        </button>
                    </div>

                    <div class="auth-wrap">
                        <div class="auth-card">
                            <div class="text-center mb-4">
                                <div class="d-inline-flex align-items-center justify-content-center p-3 rounded-4 mb-3" style="background: var(--accent); color: #fff; width: 56px; height: 56px;">
                                    <i class="fa fa-cut fs-4"/>
                                </div>
                                <h3 class="fw-bold mb-1" style="color: var(--text-main);">Beauty Professional</h3>
                                <p class="small mb-0" style="color: var(--text-muted);">Sign in to manage your appointments &amp; services</p>
                            </div>

                            <t t-if="error">
                                <div class="alert alert-danger rounded-3 small p-3 mb-4" role="alert">
                                    <i class="fa fa-exclamation-circle me-1"/> <t t-esc="error"/>
                                </div>
                            </t>

                            <form method="post" action="/beauty/login">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="redirect" t-att-value="redirect"/>

                                <div class="mb-3">
                                    <label class="form-label small fw-semibold" style="color: var(--text-muted);">Email or Username</label>
                                    <input type="text" name="login" class="form-control" placeholder="barber@example.com" t-att-value="login" required="required"/>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label small fw-semibold" style="color: var(--text-muted);">Password</label>
                                    <input type="password" name="password" class="form-control" placeholder="••••••••" required="required"/>
                                </div>

                                <button type="submit" class="btn btn-auth mb-3">
                                    Sign In
                                </button>
                            </form>

                            <div class="text-center mt-3 pt-3 border-top" style="border-color: var(--border-color) !important;">
                                <p class="small mb-1" style="color: var(--text-muted);">Don't have a professional account?</p>
                                <a href="/beauty/register" class="fw-bold text-decoration-none small" style="color: var(--accent);">
                                    Register as Beauty Professional <i class="fa fa-arrow-right ms-1"/>
                                </a>
                            </div>
                        </div>
                    </div>

                    <script>
                        function toggleTheme() {
                            const current = document.documentElement.getAttribute('data-theme') || 'light';
                            const next = current === 'dark' ? 'light' : 'dark';
                            document.documentElement.setAttribute('data-theme', next);
                            localStorage.setItem('beauty_theme', next);
                            updateThemeIcon(next);
                        }
                        function updateThemeIcon(theme) {
                            const icon = document.getElementById('themeToggleIcon');
                            if (icon) {
                                icon.className = theme === 'dark' ? 'fa fa-sun-o' : 'fa fa-moon-o';
                            }
                        }
                        (function() {
                            const saved = localStorage.getItem('beauty_theme') || 'light';
                            document.documentElement.setAttribute('data-theme', saved);
                            window.addEventListener('DOMContentLoaded', () => updateThemeIcon(saved));
                        })();
                    </script>
                </body>
            </html>
        </template>

        <!-- Professional Registration Template -->
        <template id="portal_register" name="Professional Self Registration">
            <html>
                <head>
                    <meta charset="utf-8"/>
                    <meta name="viewport" content="width=device-width, initial-scale=1"/>
                    <title>Beauty Professional - Registration</title>
                    <link rel="stylesheet" href="/web/static/lib/bootstrap/dist/css/bootstrap.css"/>
                    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"/>
                    <link rel="stylesheet" href="/web/static/src/libs/fontawesome/css/font-awesome.css"/>
                    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer"/>
                    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap"/>
                    <style>
                        :root, [data-theme="light"] {
                            --bg-main: #f8fafc;
                            --bg-card: #ffffff;
                            --border-color: #e2e8f0;
                            --text-main: #0f172a;
                            --text-muted: #64748b;
                            --accent: #6366f1;
                            --input-bg: #f8fafc;
                        }
                        [data-theme="dark"] {
                            --bg-main: #0b0f19;
                            --bg-card: #111827;
                            --border-color: #1f2937;
                            --text-main: #f9fafb;
                            --text-muted: #9ca3af;
                            --accent: #818cf8;
                            --input-bg: #1f2937;
                        }
                        body {
                            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
                            background-color: var(--bg-main);
                            color: var(--text-main);
                            min-height: 100vh;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            margin: 0;
                            position: relative;
                        }
                        .reg-wrap {
                            padding: 40px 15px;
                            width: 100%;
                            max-width: 640px;
                        }
                        .reg-card {
                            background-color: var(--bg-card);
                            border: 1px solid var(--border-color);
                            border-radius: 24px;
                            box-shadow: 0 4px 25px rgba(0,0,0,0.04);
                            padding: 2.5rem;
                        }
                        .theme-top-right {
                            position: absolute;
                            top: 20px;
                            right: 20px;
                        }
                        .theme-toggle-btn {
                            background: transparent;
                            border: 1px solid var(--border-color);
                            color: var(--text-main);
                            width: 40px;
                            height: 40px;
                            border-radius: 50%;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            cursor: pointer;
                        }
                        .form-control, .form-select {
                            background-color: var(--input-bg);
                            border: 1px solid var(--border-color);
                            color: var(--text-main);
                            border-radius: 12px;
                            padding: 11px 14px;
                        }
                        .btn-reg {
                            background-color: var(--accent);
                            color: #ffffff;
                            border: none;
                            border-radius: 999px;
                            padding: 0.85rem;
                            font-weight: 700;
                            width: 100%;
                            min-height: 48px;
                            display: inline-flex;
                            align-items: center;
                            justify-content: center;
                        }
                        @media (max-width: 575.98px) {
                            .reg-wrap {
                                padding: 24px 12px;
                            }
                            .reg-card {
                                padding: 1.5rem 1.25rem !important;
                                border-radius: 20px !important;
                            }
                            .form-control, .form-select {
                                font-size: 16px !important;
                            }
                            .theme-top-right {
                                top: 12px;
                                right: 12px;
                            }
                        }
                    </style>
                </head>
                <body>
                    <div class="theme-top-right">
                        <button class="theme-toggle-btn" onclick="toggleTheme()" title="Toggle Dark/Light Mode">
                            <i id="themeToggleIcon" class="fa fa-moon-o"/>
                        </button>
                    </div>

                    <div class="reg-wrap">
                        <div class="reg-card">
                            <div class="text-center mb-4">
                                <div class="d-inline-flex align-items-center justify-content-center p-3 rounded-4 mb-3" style="background: var(--accent); color: #fff; width: 56px; height: 56px;">
                                    <i class="fa fa-user-plus fs-4"/>
                                </div>
                                <h3 class="fw-bold mb-1" style="color: var(--text-main);">Become a Beauty Professional</h3>
                                <p class="small mb-0" style="color: var(--text-muted);">Create your account to start accepting customer bookings online</p>
                            </div>

                            <t t-if="error">
                                <div class="alert alert-danger rounded-3 small p-3 mb-4" role="alert">
                                    <i class="fa fa-exclamation-circle me-1"/> <t t-esc="error"/>
                                </div>
                            </t>

                            <form method="post" action="/beauty/register">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label small fw-semibold" style="color: var(--text-muted);">Full Name *</label>
                                        <input type="text" name="name" class="form-control" placeholder="e.g. John Doe" t-att-value="post.get('name', '')" required="required"/>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label small fw-semibold" style="color: var(--text-muted);">Professional Type *</label>
                                        <select name="professional_type" class="form-select" required="required">
                                            <option value="barber" t-att-selected="post.get('professional_type') == 'barber'">Barber</option>
                                            <option value="hairdresser" t-att-selected="post.get('professional_type') == 'hairdresser'">Hairdresser</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label small fw-semibold" style="color: var(--text-muted);">Email Address *</label>
                                        <input type="email" name="email" class="form-control" placeholder="john@example.com" t-att-value="post.get('email', '')" required="required"/>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label small fw-semibold" style="color: var(--text-muted);">Booking URL Username *</label>
                                        <div class="input-group">
                                            <span class="input-group-text" style="background: var(--input-bg); border-color: var(--border-color); color: var(--text-muted);">/book/</span>
                                            <input type="text" name="username" class="form-control" placeholder="john_barber" t-att-value="post.get('username', '')" required="required"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label small fw-semibold" style="color: var(--text-muted);">Password *</label>
                                        <input type="password" name="password" class="form-control" placeholder="At least 6 characters" required="required"/>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label small fw-semibold" style="color: var(--text-muted);">Confirm Password *</label>
                                        <input type="password" name="confirm_password" class="form-control" placeholder="Re-enter password" required="required"/>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label small fw-semibold" style="color: var(--text-muted);">Phone Number</label>
                                        <input type="tel" name="phone" class="form-control" placeholder="+1234567890" t-att-value="post.get('phone', '')"/>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label small fw-semibold" style="color: var(--text-muted);">Location / Shop Address</label>
                                        <input type="text" name="location" class="form-control" placeholder="Downtown Studio #4" t-att-value="post.get('location', '')"/>
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-reg mt-2 mb-3">
                                    Create Account
                                </button>
                            </form>

                            <div class="text-center mt-3 pt-3 border-top" style="border-color: var(--border-color) !important;">
                                <p class="small mb-1" style="color: var(--text-muted);">Already registered?</p>
                                <a href="/beauty/login" class="fw-bold text-decoration-none small" style="color: var(--accent);">
                                    <i class="fa fa-sign-in me-1"/> Sign in to Professional Portal
                                </a>
                            </div>
                        </div>
                    </div>

                    <script>
                        function toggleTheme() {
                            const current = document.documentElement.getAttribute('data-theme') || 'light';
                            const next = current === 'dark' ? 'light' : 'dark';
                            document.documentElement.setAttribute('data-theme', next);
                            localStorage.setItem('beauty_theme', next);
                            updateThemeIcon(next);
                        }
                        function updateThemeIcon(theme) {
                            const icon = document.getElementById('themeToggleIcon');
                            if (icon) {
                                icon.className = theme === 'dark' ? 'fa fa-sun-o' : 'fa fa-moon-o';
                            }
                        }
                        (function() {
                            const saved = localStorage.getItem('beauty_theme') || 'light';
                            document.documentElement.setAttribute('data-theme', saved);
                            window.addEventListener('DOMContentLoaded', () => updateThemeIcon(saved));
                        })();
                    </script>
                </body>
            </html>
        </template>
    </data>
</odoo>
