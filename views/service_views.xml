<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Service List -->

    <record id="view_beauty_service_tree" model="ir.ui.view">
        <field name="name">beauty.service.tree</field>
        <field name="model">beauty.service</field>
        <field name="arch" type="xml">

            <tree>
                <field name="name"/>
                <field name="professional_id"/>
                <field name="price"/>
                <field name="duration"/>
                <field name="active"/>
            </tree>

        </field>
    </record>


    <!-- Service Form -->

    <record id="view_beauty_service_form" model="ir.ui.view">
        <field name="name">beauty.service.form</field>
        <field name="model">beauty.service</field>
        <field name="arch" type="xml">

            <form>

                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>

                        <group>
                            <field name="professional_id"/>
                            <field name="price"/>
                            <field name="duration"/>
                        </group>

                        <group>
                            <field name="active"/>
                        </group>

                    </group>

                    <notebook>

                        <page string="Description">
                            <field name="description"/>
                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>

</odoo>