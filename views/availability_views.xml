<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Availability Tree View -->

    <record id="view_beauty_availability_tree" model="ir.ui.view">
        <field name="name">beauty.availability.tree</field>
        <field name="model">beauty.availability</field>
        <field name="arch" type="xml">

            <tree>
                <field name="professional_id"/>
                <field name="day_of_week"/>
                <field name="time_start"/>
                <field name="time_end"/>
                <field name="is_working_day"/>
            </tree>

        </field>
    </record>


    <!-- Availability Form View -->

    <record id="view_beauty_availability_form" model="ir.ui.view">
        <field name="name">beauty.availability.form</field>
        <field name="model">beauty.availability</field>
        <field name="arch" type="xml">

            <form>

                <sheet>

                    <div class="oe_title">
                        <label for="professional_id"/>
                        <h1>
                            <field name="professional_id"/>
                        </h1>
                    </div>

                    <group>

                        <group>
                            <field name="day_of_week"/>
                            <field name="is_working_day"/>
                        </group>

                        <group>
                            <field name="time_start"
                                   help="Time in decimal format (e.g., 09.00 for 9:00 AM)"/>
                            <field name="time_end"
                                   help="Time in decimal format (e.g., 17.00 for 5:00 PM)"/>
                        </group>

                    </group>

                </sheet>

            </form>

        </field>
    </record>


    <!-- Availability embedded in Professional Form -->

    <record id="view_beauty_professional_form" model="ir.ui.view">
        <field name="name">beauty.professional.form</field>
        <field name="model">beauty.professional</field>
        <field name="arch" type="xml">

            <form>

                <sheet>

                    <div class="oe_button_box" name="button_box"/>

                    <widget name="web_ribbon"
                            text="Verified"
                            bg_color="bg-success"
                            attrs="{'invisible': [('verified', '=', False)]}"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>

                        <group>
                            <field name="user_id"/>
                            <field name="professional_type"/>
                            <field name="username"/>
                            <field name="verified"/>
                        </group>

                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="location"/>
                            <field name="active"/>
                        </group>

                    </group>

                    <notebook>

                        <page string="Profile">

                            <group>
                                <field name="profile_image"
                                       widget="image"
                                       class="oe_avatar"/>

                                <field name="bio"/>
                            </group>

                        </page>

                        <page string="Services">

                            <field name="service_ids">

                                <tree editable="bottom">

                                    <field name="name"/>
                                    <field name="price"/>
                                    <field name="duration"/>
                                    <field name="active"/>

                                </tree>

                            </field>

                        </page>

                        <page string="Availability">

                            <field name="availability_ids">

                                <tree editable="bottom">

                                    <field name="day_of_week"/>
                                    <field name="time_start"/>
                                    <field name="time_end"/>
                                    <field name="is_working_day"/>

                                </tree>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>

</odoo>
